# Generated by sadr; `sadr init` rewrites this file. Add or replace recipes in justfile.
# Prettier, oxlint and the type checkers are dev dependencies, run through bun.

# The gate: formatting, lint, types, tests, then the repo's own hygiene
check: format-check lint typecheck test audit

# What CI runs: a clean install from the lockfile, the gate, then a build
ci: install check build

# Install exactly what the lockfile lists
install:
    bun install --frozen-lockfile

# Fail on any file Prettier would change
format-check:
    bun x --no-install prettier --check .

# Rewrite files the way Prettier and oxlint's fixers want them
format:
    bun x --no-install prettier --write .
    bun x --no-install oxlint --type-aware --disable-nested-config --fix

# Lint every TypeScript and JavaScript file with the root's rules; warnings fail too
lint:
    bun x --no-install oxlint --type-aware --disable-nested-config --deny-warnings

# Type-check every package, though not the type declarations its dependencies ship
typecheck:
    bun x --no-install tsc --noEmit --skipLibCheck -p .

# Run the tests; none yet passes too
test:
    bun test --pass-with-no-tests

# Build what the project ships; nothing yet
build:

# Spelling, workflow mistakes and security problems, the commit hook, and secrets in any commit.
# zizmor also runs its online audits when GH_TOKEN is set, as it is in CI.
audit:
    typos --hidden --exclude .git
    actionlint
    zizmor --no-progress .github/workflows
    shellcheck .githooks/pre-commit
    gitleaks git --redact --no-banner
