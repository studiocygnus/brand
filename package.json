{
  "name": "@studiocygnus/brand",
  "version": "1.0.0",
  "description": "The Studio Cygnus brand: Tailwind v4 theme, CSS variables, logos and fonts",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/studiocygnus/brand.git"
  },
  "type": "module",
  "files": [
    "dist",
    "logos"
  ],
  "exports": {
